{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/minimax-m2.5-free",
    "agent": {
        "development-manager": {
            "model": "opencode/minimax-m2.5-free"
        }
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
